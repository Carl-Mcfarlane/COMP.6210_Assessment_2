SUPABASE_URL=https://your-project.supabase.co
# service-role key: server-side only, never expose to the frontend
SUPABASE_KEY=
PORT=5000
# comma-separated frontend origins allowed by CORS, e.g. http://localhost:5173,https://your-app.vercel.app
# leave unset to allow any origin (local development only)
CORS_ORIGIN=
# set to 1 when hosted behind a proxy (Vercel, Render, Railway...) so rate limiting works per visitor
TRUST_PROXY=
